[Unit]
Description=IoT Gateway Scheduler (offline detect, command timeout, partition mgmt)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
User=iot
Group=iot
WorkingDirectory=/opt/iot-platform/server
EnvironmentFile=/etc/iot-platform/scheduler.env
ExecStart=/opt/iot-platform/server/.venv/bin/iot-scheduler

WatchdogSec=30
TimeoutStartSec=60
Restart=always
RestartSec=10
StartLimitBurst=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-scheduler

[Install]
WantedBy=multi-user.target
