    "baudrate": 9600,
    "parity": "N",
    "data_bits": 8,
    "stop_bits": 1
  },
  "measurements": [
    {
      "key": "ammonia",
      "display_name": "암모니아 NH3",
      "unit": "ppm",
      "data_type": "float",
      "modbus": { "function_code": 3, "register": 0, "length": 1 },
      "scale": 0.1, "min": 0, "max": 100,
      "visualization": "gauge",
      "display_group": "hazardous_gas",
      "order": 1
    }
  ]
