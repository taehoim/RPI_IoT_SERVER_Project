    {"type": "text", "id": "title", "x": 700, "y": 30, "width": 1100, "height": 38, "text": "상세 시스템 구성도 (Detailed Architecture)", "originalText": "상세 시스템 구성도 (Detailed Architecture)", "fontSize": 32, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200001, "version": 1, "versionNonce": 200002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
