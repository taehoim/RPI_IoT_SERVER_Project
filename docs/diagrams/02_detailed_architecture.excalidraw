    {"type": "text", "id": "pg_t", "x": 115, "y": 755, "width": 470, "height": 190, "text": "postgresql.service  :5432\n\ndb=iot_platform · db=keycloak\ncompanies · sites · users · gateways\nsensor_profiles · sensor_channels\ntelemetry (월별 PARTITION) · telemetry_latest\ncommands · alarm_rules · audit_logs\nRLS 적용 검토 (Phase 6+)", "originalText": "postgresql.service  :5432\n\ndb=iot_platform · db=keycloak\ncompanies · sites · users · gateways\nsensor_profiles · sensor_channels\ntelemetry (월별 PARTITION) · telemetry_latest\ncommands · alarm_rules · audit_logs\nRLS 적용 검토 (Phase 6+)", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200072, "version": 1, "versionNonce": 200073, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "pg", "lineHeight": 1.35},

