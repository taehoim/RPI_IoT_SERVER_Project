    {"type": "rectangle", "id": "systemd", "x": 100, "y": 1220, "width": 1030, "height": 230, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200100, "version": 1, "versionNonce": 200101, "isDeleted": false, "groupIds": [], "boundElements": [{"id": "systemd_t", "type": "text"}], "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "systemd_t", "x": 115, "y": 1235, "width": 1000, "height": 200, "text": "systemd unit 공통 정책\n\nType=notify  ·  WatchdogSec=30  ·  Restart=always  ·  RestartSec=5  ·  StartLimitBurst=5\nNoNewPrivileges=true  ·  PrivateTmp=true  ·  ProtectSystem=full  ·  ProtectHome=true\nMemoryMax=512M  ·  LimitNOFILE=4096  ·  StandardOutput=journal\nEnvironmentFile=/etc/iot-platform/{name}.env\nAfter=network-online.target postgresql.service vernemq.service", "originalText": "systemd unit 공통 정책\n\nType=notify  ·  WatchdogSec=30  ·  Restart=always  ·  RestartSec=5  ·  StartLimitBurst=5\nNoNewPrivileges=true  ·  PrivateTmp=true  ·  ProtectSystem=full  ·  ProtectHome=true\nMemoryMax=512M  ·  LimitNOFILE=4096  ·  StandardOutput=journal\nEnvironmentFile=/etc/iot-platform/{name}.env\nAfter=network-online.target postgresql.service vernemq.service", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200102, "version": 1, "versionNonce": 200103, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "systemd", "lineHeight": 1.5},

